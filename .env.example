# Required. Gemini API key (AI Studio). Lyria music needs a paid-tier key.
GEMINI_KEY=

# Optional but recommended. Raises the GitHub API allowance for fetching PRs. Server-only.
GITHUB_TOKEN=

# Vercel Blob. Set automatically when a Blob store is connected to the Vercel project.
# Without it, local dev stores puzzles in ./.data/
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public": must match the store's access setting.
BLOB_ACCESS=private

# Optional model overrides.
# GEMINI_DESIGN_MODEL=gemini-4-argon
# GEMINI_DESIGN_THINKING=medium
# GEMINI_FALLBACK_MODELS=gemini-4-hydrogen,gemini-4-carbon
# GEMINI_BACKUP_MODEL=gemini-4-hydrogen
# GEMINI_DECISION_MODEL=gemini-decision-1
# GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# Cutscenes: Gemini Omni Flash at 360p, 15s (about $0.35 each).
# GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
