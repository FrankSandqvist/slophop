# Required. Gemini API key (AI Studio). Lyria music needs a billing-enabled (paid tier) key.
GEMINI_KEY=

# Optional. Raises the GitHub API allowance for picking PRs. Server-only.
GITHUB_TOKEN=

# Vercel Blob. Set automatically when a Blob store is connected to the Vercel project.
# Without it, local dev stores puzzles in ./.data/
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public": must match the store's access setting.
BLOB_ACCESS=private

# Optional model overrides (Gemini 4 defaults: research Hydrogen, design Carbon, build Argon).
# GEMINI_RESEARCH_MODEL=gemini-4-hydrogen
# GEMINI_DESIGN_MODEL=gemini-4-carbon
# GEMINI_BUILD_MODEL=gemini-4-argon
# GEMINI_FALLBACK_MODELS=gemini-4-argon,gemini-4-hydrogen,gemini-4-carbon
# Thinking: low | medium | high (Hydrogen also xhigh). No "minimal" on Gemini 4.
# GEMINI_RESEARCH_THINKING=low
# GEMINI_DESIGN_THINKING=medium
# GEMINI_BUILD_THINKING=high
# GEMINI_BUILD_MAX_TOKENS=65536
# RESEARCH_MAX_TURNS=6
# RESEARCH_BUDGET_MS=50000
# GEMINI_MUSIC_MODEL=lyria-3-clip-preview
# Images (cover + sprite sheet per puzzle, ~$0.03 each). Set IMAGES=off to disable.
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# IMAGES=off
